// Frontend Prisma Schema — PostgreSQL
// Points to the same database as the backend for data consistency

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  emailVerified           DateTime?
  hashedPassword          String?
  name                    String
  image                   String?
  role                    String    @default("user")
  verificationCode        String?
  verificationCodeExpires DateTime?
  pendingEmail            String?
  subscriptionTier        String    @default("free")
  stripeCustomerId        String?
  subscriptionId          String?
  subscriptionStatus      String?
  isSuspended             Boolean   @default(false)
  trialEndsAt             DateTime?
  hasUsedTrial            Boolean   @default(false)
  cvCreatedCount          Int       @default(0)
  aiUsedCount             Int       @default(0)
  aiUsedToday             Int       @default(0)
  downloadCount           Int       @default(0)
  coverLetterCount        Int       @default(0)
  lastAiResetDate         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  resumes                 Resume[]
  payments                Payment[]
  accounts                Account[]
  sessions                Session[]
  communityTemplates      CommunityTemplate[]
  templateComments        TemplateComment[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([subscriptionTier])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  targetRole       String?
  targetCompany    String?
  fullName         String
  email            String?
  phone            String?
  location         String?
  linkedinUrl      String?
  portfolioUrl     String?
  summary          String?  @db.Text
  experiences      String?  @db.Text
  education        String?  @db.Text
  skills           String?  @db.Text
  certifications   String?  @db.Text
  projects         String?  @db.Text
  languages        String?  @db.Text
  templateLayout   String   @default("CLASSIC")
  templateTheme    String   @default("NAVY")
  customThemeColor String?
  atsScore         Int?
  isMaster         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String    @db.Text
  content     String    @db.Text
  image       String?
  imageAlt    String?
  category    String
  tags        String    @db.Text
  author      String
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentId String   @unique
  amount          Int
  currency        String   @default("usd")
  status          String
  type            String
  plan            String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([stripePaymentId])
  @@index([createdAt])
}

model ContentSource {
  id             String          @id @default(uuid())
  name           String
  filename       String
  type           String          @default("pdf")
  content        String          @db.Text
  pageCount      Int?
  metadata       String?         @db.Text
  createdAt      DateTime        @default(now())
  scheduledPosts ScheduledPost[]
}

model ScheduledPost {
  id           String         @id @default(uuid())
  title        String
  slug         String
  description  String         @db.Text
  content      String         @db.Text
  category     String
  tags         String         @db.Text
  scheduledFor DateTime
  status       String         @default("pending")
  sourceId     String?
  source       ContentSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  blogPostId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([sourceId])
}

model AutoBlogSettings {
  id          String   @id @default(uuid())
  postsPerDay Int      @default(5)
  startHour   Int      @default(8)
  endHour     Int      @default(20)
  enabled     Boolean  @default(false)
  authorName  String   @default("ResumeAI Team")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunityTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  category    String   @default("professional")
  designData  String   @db.Text
  thumbnail   String?  @db.Text
  downloads   Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    TemplateComment[]

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@index([downloads])
}

model TemplateComment {
  id          String            @id @default(uuid())
  templateId  String
  template    CommunityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String            @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([templateId])
  @@index([userId])
}

// Frontend-only models

model PlanConfig {
  id               String   @id @default(uuid())
  planType         String   @unique
  cvLimit          Int
  aiLimit          Int
  downloadLimit    Int
  coverLetterLimit Int
  trialDailyLimit  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GlobalSettings {
  id                       String   @id @default(uuid())
  googleAnalyticsId        String?
  googleSiteVerification   String?
  bingSiteVerification     String?
  yandexSiteVerification   String?
  sitemapUrl               String?
  updatedAt                DateTime @updatedAt
}
