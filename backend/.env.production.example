# Production Environment Variables for Backend
# Copy this to your GCP Secret Manager

# Server Configuration
PORT=4444
HOST=0.0.0.0
NODE_ENV=production

# Database (Cloud SQL PostgreSQL)
# Format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://resume_app:YOUR_PASSWORD@/resume_builder?host=/cloudsql/ai-resume-builder-prod:us-central1:resume-db"

# Authentication
JWT_SECRET="generate-with-openssl-rand-base64-32"

# CORS (your frontend domain)
CORS_ORIGINS="https://www.bestairesumes.com,https://bestairesumes.com"

# Stripe (Production Keys)
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"
STRIPE_PRICE_STARTER="price_xxxxxxxxxxxxx"
STRIPE_PRICE_GOLD="price_xxxxxxxxxxxxx"
STRIPE_PRICE_DIAMOND="price_xxxxxxxxxxxxx"
STRIPE_PRICE_PLATINUM="price_xxxxxxxxxxxxx"

# OpenAI
OPENAI_API_KEY="sk-xxxxxxxxxxxxx"

# Brevo (Email)
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxx"
EMAIL_FROM_ADDRESS="noreply@bestairesumes.com"

# Sentry (Error Monitoring)
SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"
SENTRY_RELEASE="ai-resume-builder@1.0.0"
