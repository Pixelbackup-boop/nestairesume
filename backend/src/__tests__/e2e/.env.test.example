# Stripe Sandbox E2E Test Configuration
# Copy this file to .env.test and fill in your Stripe test keys

# Stripe Test Mode Keys (from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Price IDs for each plan (from https://dashboard.stripe.com/test/products)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GOLD=price_xxx
STRIPE_PRICE_DIAMOND=price_xxx
STRIPE_PRICE_PLATINUM=price_xxx

# Test Database (optional - uses dev.db by default)
DATABASE_URL="file:./test.db"

# JWT Secret (can use any value for tests)
JWT_SECRET=test-jwt-secret-for-e2e-tests
